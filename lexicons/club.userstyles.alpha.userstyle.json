						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"updatedAt": {
						"type": "string",
						"format": "datetime"
					}
				},
				"required": ["name", "sourceCode", "createdAt", "updatedAt"]
			},
			"description": "Record declaring a userstyle's contents and metadata."
		}
	}
