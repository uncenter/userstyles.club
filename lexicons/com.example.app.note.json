{
  "lexicon": 1,
  "id": "com.example.app.note",
  "defs": {
    "main": {
      "type": "record",
      "description": "A simple note record used by the starter template as a custom collection example.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 300,
            "description": "Short note content."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "RFC3339 timestamp."
          }
        }
      }
    }
  }
}
