{
  "defs": {
    "main": {
      "description": "A UserCSS userstyle.",
      "key": "tid",
      "record": {
        "properties": {
          "title": {
            "type": "string",
            "maxGraphemes": 140,
            "minGraphemes": 1
          },
          "description": {
            "type": "string",
            "maxGraphemes": 300
          },
          "sourceCode": {
            "accept": ["text/plain"],
            "maxSize": 5000000,
            "type": "blob"
          },
          "previewImage": {
            "accept": ["image/*"],
            "maxSize": 1000000,
            "type": "blob"
          },
          "license": {
            "type": "string",
            "maxLength": 100
          },
          "upstreamUrl": {
            "type": "string",
            "format": "uri"
          },
          "homepageUrl": {
            "type": "string",
            "format": "uri"
          },
          "ignoreUpdateUrl": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": ["title", "sourceCode", "createdAt"],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "club.userstyles.alpha.userstyle",
  "lexicon": 1
}
