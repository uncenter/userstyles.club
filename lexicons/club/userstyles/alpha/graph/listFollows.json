{
  "defs": {
    "main": {
      "description": "List the users an actor follows, most recent first.",
      "errors": [
        {
          "name": "ActorNotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "follows": {
              "items": {
                "ref": "club.userstyles.alpha.defs#followView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": ["follows"],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": ["actor"],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "club.userstyles.alpha.graph.listFollows",
  "lexicon": 1
}
