{
  "defs": {
    "main": {
      "description": "A single list's details plus its saved userstyles, most recently added first.",
      "errors": [
        {
          "name": "ListNotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "list": {
              "ref": "club.userstyles.alpha.defs#listView",
              "type": "ref"
            },
            "cursor": {
              "type": "string"
            },
            "items": {
              "items": {
                "ref": "club.userstyles.alpha.defs#listItemView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": ["list", "items"],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "actor": {
            "type": "string",
            "format": "did"
          },
          "rkey": {
            "type": "string",
            "format": "record-key"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": ["actor", "rkey"],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "club.userstyles.alpha.graph.getList",
  "lexicon": 1
}
