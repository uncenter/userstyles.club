{
  "defs": {
    "main": {
      "description": "A comment on a userstyle. Can be a reply to another comment.",
      "key": "tid",
      "record": {
        "properties": {
          "subject": {
            "ref": "com.atproto.repo.strongRef",
            "type": "ref"
          },
          "parent": {
            "ref": "com.atproto.repo.strongRef",
            "type": "ref"
          },
          "comment": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": ["subject", "comment", "createdAt"],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "club.userstyles.alpha.feed.comment",
  "lexicon": 1
}
