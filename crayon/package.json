{
  "name": "crayon",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "files": [
    "dist",
    "drizzle",
    "drizzle.config.ts"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
