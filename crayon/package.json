    "@atproto/lex": "^0.3.0",
    "@bsky/jetstream": "^1.0.0",
    "@remix-run/node-fetch-server": "^0.14.0",
    "@userstyles.club/atcute": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "usercss-parser": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
