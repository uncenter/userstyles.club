{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "club.userstyles.alpha.graph.review",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        },
        "required": ["subject", "comment", "createdAt"]
      },
      "description": "Record representing a review of a userstyle, consisting of a comment and an optional numerical rating."
    }
  }
}
