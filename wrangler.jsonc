{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "userstyles-club",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  // Backs OAuth sessions/state and app login-session cookies (see src/lib/server/oauth.ts).
  // Create with `wrangler kv namespace create OAUTH_KV` and replace the id below.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
}
